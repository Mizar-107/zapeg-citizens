# Ollama Cloud uses the default URL. For a local host Ollama reached from Docker,
# use http://host.docker.internal:11434/api/chat and omit the API key.
CITIZENS_LLM_URL=https://ollama.com/api/chat
CITIZENS_LLM_API_KEY=replace-with-ollama-key
CITIZENS_LLM_MODEL=replace-with-model-name

# A separate random secret shared only by the Minecraft server mod and this service.
CITIZENS_BRAIN_TOKEN=replace-with-a-long-random-token

CITIZENS_BIND=0.0.0.0
CITIZENS_PORT=8787
CITIZENS_DB_PATH=/data/citizens-brain.sqlite3

# Defaults are intentionally conservative. Increase only after measuring the host.
CITIZENS_LLM_CONCURRENCY=1
CITIZENS_LLM_QUEUE_TIMEOUT_SECONDS=20
CITIZENS_LLM_TIMEOUT_SECONDS=90
CITIZENS_MAX_TOOL_STEPS=8
# Per-tool descriptions include Numen's detailed execution contracts. The default
# accepts the full BuildTool description while retaining a per-tool resource cap.
CITIZENS_MAX_TOOL_DESCRIPTION_CHARS=4096
CITIZENS_MAX_TOOL_SCHEMA_BYTES=131072
CITIZENS_MAX_TOOLS=64
# Maximum trusted lore/persona text accepted for one citizen (hard cap: 16384).
CITIZENS_MAX_PERSONA_CHARS=4096
CITIZENS_MAX_ACTIVE_TURNS=64
CITIZENS_TURN_TTL_SECONDS=900
CITIZENS_MAX_HISTORY_MESSAGES=24
CITIZENS_TERMINAL_TURN_TTL_SECONDS=86400
CITIZENS_MAX_TERMINAL_TURNS=1000

# Docker/Kubernetes secrets can be used instead of direct values. Never set both
# forms of the same secret.
# CITIZENS_LLM_API_KEY_FILE=/run/secrets/ollama_api_key
# CITIZENS_BRAIN_TOKEN_FILE=/run/secrets/citizens_brain_token
